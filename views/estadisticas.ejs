<div class="container my-5">
  <h1 class="text-center mb-4">Estadísticas de Reservas</h1>

  <!-- Total de reservas -->
  <div class="row mb-4">
    <div class="col-12 col-md-4 mb-3 tablaEstadisticas">
      <div class="p-3 border rounded text-center ctablaEstadisticas">
        <h5>Total Reservas</h5>
        <div id="totalReservas"></div>
      </div>
    </div>

    <!-- Vehículo más usado -->
    <div class="col-12 col-md-8 mb-3">
      <div class="p-3 border rounded text-center ctablaEstadisticas">
        <h5>Vehículo Más Usado</h5>
        <div id="vehiculosMasUsado"></div>
      </div>
    </div>
  </div>

  <!-- Reservas por concesionario -->
  <div class="row">
    <div class="col-12">
      <h3 class="mb-3">Reservas por Concesionario</h3>
      <div class="table-responsive">
        <table class="table table-striped table-bordered" id="tablaConcesionarios">
          <thead class="table-dark">
            <tr>
              <th>Concesionario</th>
              <th>Número de Reservas</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
    </div>
  </div>
</div>