<div class="container" id="alertContainer"></div>
<div class="container-fluid">
  <div class="row text-left align-items-start">
    <!-- BOTÓN FILTROS SOLO MÓVIL -->
    <div class="d-md-none mb-3">
      <button class="btn btn-dark w-100" data-bs-toggle="modal" data-bs-target="#modalFiltros">
        <i class="bi bi-funnel"></i> Filtros
      </button>
    </div>

    <div class="col-2 col-md-2 d-none d-md-block">
      <form id="filtroVehiculos" action="/vehiculos" method="GET" class="align-items-center" >
        <div id="mensaje"></div>
        <h5><b>FILTROS</b></h5>

        <div>
          <label for="filtroMarca">Marca:</label>
          <select id="filtroMarca" name="filtroMarca">
              <option value="" selected></option>
          </select>
        </div>

        <div>
          <label for="filtroColor">Color:</label>
          <input type="text" id="filtroColor" name="filtroColor">
        </div>

        <div>
          <label for="filtroConcesionario">Concesionario:</label>
          <select id="filtroConcesionario" name="filtroConcesionario">
              <option value="" selected></option>
          </select>
        </div>

        <div>
          <label for="filtroCiudad">Ciudad:</label>
          <input type="text" id="filtroCiudad" name="filtroCiudad">
        </div>

        <div>
          <label for="filtroPlazas">Plazas:</label>
          <input type="number" id="filtroPlazas" name="plazas" min="1" max="100">
        </div>

        <div>
          <label for="filtroAutonomia">Autonomia:</label>
          <select id="filtroAutonomia" name="filtroAutonomia">
              <option value=""></option>
              <option value="minima" <%= filtro === "marca" ? "selected" : "" %> >Mínima</option>
              <option value="maxima" <%= filtro === "modelo" ? "selected" : "" %> >Máxima</option>
          </select>
        </div>

        <div>
          <label for="filtroTipo">Tipo:</label>
          <select id="filtroTipo" name="filtroTipo">
              <option value="" selected>Todos</option>
          </select>
        </div>
      </form>
    </div>

    <!-- LISTA DE VEHÍCULOS -->
    <div class="col-12 col-md-10">
      <section id="listaVehiculos">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h2 id="tituloTabla" class="m-0">Vehículos disponibles</h2>

          <% if(usuario && usuario.rol === "admin") { %>
          <a href="/vehiculos/nuevo" class="btn btn-dark">+ Añadir</a>
          <% } %>
        </div>
        <div class="table-responsive text-center">
          <table aria-labelledby="tituloTabla" class="table table-sm table-hover align-middle" id="tablavehiculos">
            <thead class="table-dark text-center">
              <tr>
                <th scope="col">Imagen</th>
                <th scope="col">Matricula</th>
                <th scope="col">Marca</th>
                <th scope="col">Modelo</th>
                <th scope="col">Año</th>
                <th scope="col">Nº de Plazas</th>
                <th scope="col">Autonomía (km)</th>
                <th scope="col">Color</th>
                <th scope="col">Concesionario</th>
                <th scope="col">Ciudad</th>
                <th scope="col">Estado</th>
                <th scope="col">Tipo</th>
                <th scope="col">Precio/Hora</th>
                <% if(usuario && usuario.rol === "admin") {%>
                    <th scope="col">Acciones</th>
                  <% } %>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </section>
    </div>
  </div>
</div>

<div class="modal fade" id="modalFiltros" tabindex="-1" aria-labelledby="modalFiltrosLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Filtros</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <form id="filtroVehiculosModal">
          <label for="filtroMarcaModal">Marca:</label>
          <select id="filtroMarcaModal" class="form-select">
            <option value=""></option>
          </select>

          <label for="filtroColorModal">Color:</label>
          <input type="text" id="filtroColorModal" class="form-control">

          <label for="filtroConcesionarioModal">Concesionario:</label>
          <select id="filtroConcesionarioModal" class="form-select">
            <option value=""></option>
          </select>

          <label for="filtroPlazasModal">Plazas:</label>
          <input type="number" id="filtroPlazasModal" class="form-control">

          <label for="filtroAutonomiaModal">Autonomía:</label>
          <select id="filtroAutonomiaModal" class="form-select">
            <option value=""></option>
            <option value="minima">Mínima</option>
            <option value="maxima">Máxima</option>
          </select>

          <label for="filtroTipoModal">Tipo:</label>
          <select id="filtroTipoModal" class="form-select">
            <option value="">Todos</option>
          </select>

        </form>
      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
        <button class="btn btn-dark" onclick="aplicarFiltrosModal()" data-bs-dismiss="modal">Aplicar</button>
      </div>

    </div>
  </div>
</div>

<script>
  const vehiculosIniciales = <%- JSON.stringify(vehiculos || []) %>; 
  const usuario = <%- JSON.stringify(usuario || null) %>;
</script>
<script src="/js/listavehiculos.js"></script>


