<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width = device-width, initial-scale=1.0" />
  <title><%= titulo || "ZeroFleet" %>Gestión de Flota de Vehículos Eléctricos</title>
  
  <!-- Bootstrap CSS y Bootstrap Date & Time Picker (Tempus Dominus) -->
  <link rel="stylesheet" href="/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/tempus-dominus.min.css">

  <!-- css global -->
  <link id="estiloGeneral" rel="stylesheet" href="/css/general.css">
  <link id="estiloHeader" rel="stylesheet" href="/css/header.css">
  <link id="estiloFooter" rel="stylesheet" href="/css/footer.css">
  <link id="estiloAccesibilidad" rel="stylesheet" href="/css/accesibilidad.css">

  <!-- Aplicar preferencias de accesibilidad desde sesión antes de renderizar contenido -->
  <script>
    (function() {
      let prefs = {};

      <% if (session?.usuario) { %>
        // Usuario autenticado: inyectar preferencias desde la sesión
        prefs = JSON.parse('<%- session.usuario.preferencias_accesibilidad || { tamanoFuente: "16px", altoContraste: false, atajos: {} } %>');
        console.log("preferencias de usuario autenticado ", prefs);
        
      <% } else { %>
        // Usuario no autenticado: intentar cargar preferencias desde localStorage
        try {
          const storedPrefs = localStorage.getItem("preferenciasAccesibilidad");
          if (storedPrefs) prefs = JSON.parse(storedPrefs);
          console.log("preferencias de usuario no autenticado ", prefs);
        } catch(e) { console.error("Error leyendo preferencias de localStorage:", e); }
      <% } %>

      // Aplicar preferencias al HTML

      if (prefs.tamanoFuente) {
        console.log("ingresa a condicion prefs.tamanoFuente");
        document.documentElement.style.fontSize = prefs.tamanoFuente;
        
      } 

      window.atajosGlobales = prefs.atajos || {};
      document.addEventListener("DOMContentLoaded", function() {
        if (prefs.altoContraste)
          document.body.classList.add("alto-contraste");

        // Retardo de 200s para evitar el flash en caso se active el modo alto contraste
        setTimeout(() => document.body.classList.add("mostrar"), 100);
        
      });
      
      console.log("en head de layout window.atajosGlobales ", window.atajosGlobales);
      window.usuarioAutenticado = <%= !!session?.usuario %>;
      console.log("usuario autenticado", window.usuarioAutenticado);
    })();
  </script>

  
  <!-- CSS específico -->
  <% if (estilo) { %>
    <link rel="stylesheet" href="/css/<%= estilo %>">
  <% } %>
</head>

<body>
  <!-- Header -->
  <%- include('partials/header') %>
  
  <main>
    <%- body %>
  </main>
  
  <!-- Footer -->
  <%- include('partials/footer') %>

  <!-- Modales globales -->
  <%- include('partials/iniciarSesion', {error: typeof error !== 'undefined' ? error: null}) %>
  <%- include('partials/registrar', {
    error: typeof error !== 'undefined' ? error : null,
    concesionarios: typeof concesionarios !== 'undefined' ? concesionarios : []}) %>
  <%- include('partials/accesibilidad') %>

  <!-- Popper, Bootstrap y Tempus Dominus JS -->
  <script src="/js/popper.min.js"></script>
  <script src="/js/bootstrap.bundle.min.js"></script>
  <script src="/js/tempus-dominus.min.js"></script>


  <!-- Script global -->
  <script>
    window.abrirModalIniciarSesion = <%= typeof abrirModalIniciarSesion !== 'undefined' && abrirModalIniciarSesion ? 'true' : 'false' %>;
    window.abrirModalRegistrar = <%= typeof abrirModalRegistrar !== 'undefined' && abrirModalRegistrar ? 'true' : 'false' %>;
  </script>

  <script src="/js/index.js"></script>

  <!-- Script específico -->
  <% if (script) { %>
    <script src="/js/<%= script %>"></script>
  <% } %>

</body>

</html>