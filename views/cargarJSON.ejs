<section id="cargarJSON">
    <h2>Carga de datos iniciales (JSON)</h2>
    <div class="container p-2 text-center">
        <form id="formulario-cargar" action="/cargar-json" method="POST" enctype="multipart/form-data">
            <div id ="mensaje"></div>
            <input type="file" name="archivo" accept="application/json" required>
            </div>
            <button id="btnCargarJSON" type="submit" class="btn btn-secondary">Cargar datos</button>
        </form>
    </div>
</section>