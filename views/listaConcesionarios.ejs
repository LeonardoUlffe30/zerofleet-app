<div class="container" id="alertContainer"></div>
<div class="container-fluid">
  <div class="row text-left align-items-start">
    <!-- BOTÓN FILTROS SOLO MÓVIL -->
    <div class="d-md-none mb-3">
      <button class="btn btn-dark w-100" data-bs-toggle="modal" data-bs-target="#modalFiltros">
        <i class="bi bi-funnel"></i> Filtros
      </button>
    </div>

    <div class="col-2 col-md-2 d-none d-md-block">
      <form id="filtroConcesionarios" action ="/concesionarios" method="GET" class="align-items-center">
        <div id="mensajes"></div>
        <h5>Filtros</h5>

        <div>
          <label for="filtroNombre">Nombre:</label>
          <input type="text" id="filtroNombre" name="filtroNombre">
        </div>

        <div>
          <label for="filtroCiudad">Ciudad:</label>
          <input type="text" id="filtroCiudad" name="filtroCiudad">
        </div>

        <div>
          <label for="filtroDireccion">Dirección:</label>
          <input type="text" id="filtroDireccion" name="filtroDireccion">
        </div>

      </form>
    </div>

    <!-- LISTA DE CONCESIONARIOS -->
    <div class="col-12 col-md-10">
      <section id="listaConcesionarios">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h2 id="tituloTabla" class="m-0">Concesionarios disponibles</h2>

          <% if(usuario && usuario.rol === "admin") { %>
          <a href="/concesionarios/nuevo" class="btn btn-dark">+ Añadir</a>
          <% } %>
        </div>
        <div class="table-responsive text-center">
          <table aria-labelledby="tituloTabla" class="table table-sm table-hover align-middle" id="tablaConcesionarios">
            <thead class="table-dark text-center">
              <tr>
                <th scope="col">Nombre</th>
                <th scope="col">Ciudad</th>
                <th scope="col">Direccion</th>
                <th scope="col">Telefono</th>
                <% if(usuario && usuario.rol === "admin") {%>
                    <th scope="col">Acciones</th>
                  <% } %>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </section>
    </div>
  </div>
</div>

<div class="modal fade" id="modalFiltros" tabindex="-1" aria-labelledby="modalFiltrosLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Filtros</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <form id="filtroConcesionariosModal">
          <label for="filtroNombreModal">Nombre:</label>
          <input type="text" id="filtroNombreModal" name="filtroNombreModal" class="form-control">

          <label for="filtroCiudadModal">Ciudad:</label>
          <input type="text" id="filtroCiudadModal" name="filtroCiudadModal" class="form-control">

          <label for="filtroDireccionModal">Dirección:</label>
          <input type="text" id="filtroDireccionModal" name="filtroDireccionModal" class="form-control">

        </form>
      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
        <button class="btn btn-dark" onclick="aplicarFiltrosModal()" data-bs-dismiss="modal">Aplicar</button>
      </div>

    </div>
  </div>
</div>

<script>
  const concesionariosIniciales = <%- JSON.stringify(concesionarios || []) %>; 
  const usuario = <%- JSON.stringify(usuario || null) %>;
</script>


