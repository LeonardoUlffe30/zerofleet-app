<section id="usuarios">
    <h2>Usuarios</h2>

    <div id="contenedor-progreso">
        <label for="progreso">Progreso</label>
        <progress id="progreso" max="100" min="0" value=""></progress>
    </div>

    <form aria-label="Formulario de usuarios" id="formulario-usuarios" 
      data-modo = "<%= usuario ? 'editar' : 'crear' %>"
      data-id = "<%= usuario && usuario.id_usuario ? usuario.id_usuario : '' %>"
      action="<%= usuario && usuario.id_usuario ? '/usuarios/' + usuario.id_usuario + '/editar' : '/usuarios/nuevo' %>" 
      method="POST">
            
        <fieldset> 
          <legend>Información del usuario</legend>

          <% if(error){ %>
            <div class = "alert alert-danger" role = "alert">
              <% error.forEach(e => { %>
                <p><%=  e.msg %></p>
                <% }) %>
            </div>
          <% } %>

          <div class="container text-left">
            <div>
              <label for="nombre">Nombre:</label>
              <input type="text" id="nombre" name="nombre" value="<%= usuario && usuario.nombre ? usuario.nombre : '' %>" required>
            </div>

            <div>
              <label for="apellido">Apellido:</label>
              <input type="text" id="apellido" name="apellido" value="<%= usuario && usuario.apellido ? usuario.apellido : '' %>" required>
            </div>
  
            <div>
              <label for="correo">Correo:</label>
              <input type="email" id="correoUsuario" name="correoUsuario" value="<%= usuario && usuario.correo ? usuario.correo : '' %>" required>
            </div>

            <div>
              <label for="rol">Seleciona el rol: </label>
              <select id="rol" name="rol" required>
                <option value="" disabled selected>Seleccione un rol</option>
                <option value="empleado" <%= usuario.rol === 'empleado' ? 'selected' : '' %>>Empleado</option>
                <option value="admin" <%= usuario.rol === 'admin' ? 'selected' : '' %>>Administrador</option>
              </select>
            </div>

            <div>
              <label for="telefono">Telefono:</label>
              <input type="text" id="telefono" name="telefono" value="<%= usuario && usuario.telefono ? usuario.telefono : '' %>" required>
            </div>

            <div>
              <label for="concesionario">Concesionario asignado:</label>
              <input type="text" id="concesionario" name="concesionario" value="<%= usuario && usuario.id_concesionario ? usuario.id_concesionario : '' %>" required>
            </div>

            <div>
              <label for="preferencias">Preferencias de accesiblidad:</label>
              <input type="text" id="preferencias" name="preferencias" value="<%= usuario && usuario.preferencias_accesibilidad ? usuario.preferencias_accesibilidad : '' %>" required>
            </div>
        </fieldset>

        <div class="form-acciones">
            <button type="submit" class="btn btn-dark">Enviar</button>
            <button type="reset" class="btn btn-light">Borrar</button>
        </div>

    </form>

    <div class="modal fade" id="confirmacionModal" tabindex="-1" aria-labelledby="confirmacionLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h3 class="modal-title" id="confirmacionLabel">Confirmar usuario</h3>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
          </div>
          <div class="modal-body">
            <p>¿Desea confirmar el usuario?</p>
            <!-- Aquí inyectadinámicamente los datos del formulario -->
            <div id="resumen-usuario"></div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="button" class="btn btn-primary" id="confirmarUsuario">Confirmar</button>
          </div>
        </div>
      </div>
    </div>
</section>
