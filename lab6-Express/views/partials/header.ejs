<header>
  <div class="navbar">
    <!--  Logo -->
    <div class="logo">
      <a href="/" aria-label="Ir a la página de inicio">
        <img src="/img/logo.png" alt="Logo de ZeroFleet" title="Logo" width="100">
        <h2>ZeroFleet</h2>
      </a>
    </div>
  
    <!-- Barra de Navegación -->
    <nav> 
      <ul class="links">
        <% if (!session || !session.usuario || session.usuario.rol === "empleado") { %>
          <!-- Usuario no autenticado o usuario autenticado con rol de empleado -->
          <li><a href="/" aria-label="Ir a la página de inicio" lang="es">Inicio</a></li>
          <li><a href="/vehiculos" aria-label="Ir a la página de vehículos" lang="es">Vehículos</a></li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="reservasDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              Reserva
            </a>
            <ul class="dropdown-menu" aria-labelledby="reservasDropdown">
              <li><a class="dropdown-item" href="/reservas/nuevo">Reservar Vehículo</a></li>
              <li><a class="dropdown-item" href="/reservas/mis-reservas">Mis Reservas</a></li>
            </ul>
          </li>
          <li><a href="/contacto" aria-label="Ir a la página de contacto" lang="es">Contacto</a>
            
          <li hidden><a href="/" aria-label="Ir a la página de inicio" lang="en" hidden>Home</a></li>
          <li hidden><a href="/vehiculos" aria-label="Ir a la página de vehículos" lang="en" hidden>Vehicles</a></li>
          <li hidden><a href="/reservas/nuevo" aria-label="Ir a la página de reserva" lang="en" hidden accesskey="r">Reserve</a></li>
          <li hidden><a href="/contacto" aria-label="Ir a la página de contacto" lang="en" hidden>Contact</a></li>
        <% } else { %>
            <!-- Usuario autenticado con rol de admin -->
            <li><a href="/vehiculos" aria-label="Ir a la página de inicio" lang="es">Vehículos</a></li>
            <li><a href="/concesionarios" aria-label="Ir a la página de vehículos" lang="es">Concesionarios</a></li>
            <li><a href="/usuarios" aria-label="Ir a la página de reserva"  lang="es" accesskey="r">Usuarios</a></li>
            <li><a href="/estadisticas" aria-label="Ir a la página de contacto" lang="es">Estadísticas</a>
        <% } %>
      </ul>
    </nav>

    <div class="acciones">
      <% if(session && session.usuario){ %>
        <!--- Usuario autentificado-->
        <span id="MensajeUsuarioNombre" aria-label = "MensajeUsuarioNombre">Bienvenido, <%= session.usuario.nombre %></span>
        <a id ="cerrar-sesion" href = "/cerrarSesion"> Cerrar Sesión</a>
      <% }else{ %>
        <!-- Iniciar sesión -->
        <a id="iniciar-sesion" href="/autenticar/iniciarSesion">Iniciar sesión</a>

        <!-- Registro -->
        <a id="registrar" href="/autenticar/registrar">Registrarse</a>
      <% } %>

      <!-- Selector de Idioma y Boton de contraste -->
      <div class="utilidades">
        <select id="idioma" name="idioma" onchange="cambiarIdioma()" aria-label="Cambiar idioma">
          <option value="es" aria-label="español" selected>ES</option>
          <option value="en" aria-label="english">EN</option>
        </select>

        <!-- Boton de accesibilidad-->
        <button class="btn btn-outline-dark ms-2" data-bs-toggle="modal" data-bs-target="#modalAccesibilidad"
          aria-label="Abrir menú de accesibilidad" style="padding: 3px 8px; border-radius: 50px;">
          <i class="bi bi-universal-access"></i>
        </button>

      </div>
      
      <div class="btn-toggle" onclick="desplegarBar()">
       <img src="/assets/icons/darkBars.svg" alt="barra desplegable de navegación" width="25px">
      </div>
   </div>
  </div>
    
  <div class="menu-dropdown">
    <nav> 
      <ul>
        <li><a href="/" aria-label="Ir a la página de inicio" lang="es">Inicio</a></li>
        <li><a href="/vehiculos" aria-label="Ir a la página de vehículos" lang="es">Vehículos</a></li>
        <li class="dropdown text-center">
          <a class="dropdown-toggle" href="#" data-bs-toggle="dropdown" data-bs-display="static"
                   data-bs-popper="none">
            Reserva
          </a>
          <ul class="dropdown-menu w-100 text-center">
            <li><a class="dropdown-item" href="/reservas/nuevo">Reservar Vehículo</a></li>
            <li><a class="dropdown-item" href="/reservas/mis-reservas">Mis Reservas</a></li>
          </ul>
        </li>
        <li><a href="/contacto" aria-label="Ir a la página de contacto" lang="es">Contacto</a>
  
        <li hidden><a href="/" aria-label="Ir a la página de inicio" lang="en" hidden>Home</a></li>
        <li hidden><a href="/vehiculos" aria-label="Ir a la página de vehículos" lang="en" hidden>Vehicles</a></li>
        <li hidden><a href="/reservas/nuevo" aria-label="Ir a la página de reserva" lang="en" hidden accesskey="r">Reserve</a></li>
        <li hidden><a href="/contacto" aria-label="Ir a la página de contacto" lang="en" hidden>Contact</a></li>
      </ul>
    </nav>

    <div class="acciones">
       <% if(session && session.usuario){ %>
        <!--- Usuario autentificado-->
        <span id="MensajeBienvenida" aria-label = "MensajeBienvenida"> Bienvenido <%= session.usuario.nombre %></span>
        <a id ="cerrar-sesion-menu" href = "/cerrarSesion"> Cerrar Sesión</a>
      <% }else{ %>
        <!-- Iniciar sesión -->
        <a id="iniciar-sesion-menu" href="/autenticar/iniciarSesion">Iniciar sesión</a>
        <!-- Registro -->
        <a id="registrar-menu" href="/autenticar/registrar">Registrarse</a>
      <% } %>
    </div>
  </div>
 
</header>
