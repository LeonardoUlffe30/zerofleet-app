<div class="modal fade" id="modalAccesibilidad" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content p-3">
      <div class="modal-header">
        <h5 class="modal-title">Opciones de accesibilidad</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body text-center">
        <!-- Tamaño de fuente -->
        <div class="d-flex flex-column gap-2 mb-3">
          <button id="btnAumentarTexto" class="btn btn-secondary">Aumentar texto</button>
          <button id="btnReducirTexto" class="btn btn-secondary">Reducir texto</button>
          <button id="btnRestablecerTexto" class="btn btn-secondary">Restablecer tamaño</button>
        </div>

        <!-- Atajo de teclado -->
        <div class="mb-2">
          <label for="atajoReservar">Atajo Reservar Vehículo:</label>
          <input type="text" id="atajoReservar" placeholder="Ctrl+R" readonly>
        </div>
        
        <div class="mb-2">
          <label for="atajoMisReservas">Atajo Mis Reservas:</label>
          <input type="text" id="atajoMisReservas" placeholder="Ctrl+H" readonly>
        </div>
        
        <div class="mb-2">
          <label for="btnContraste">Alto contraste:</label>
          <button id="btnContraste" name="Activar modo alto contraste"><i class="bi-moon-stars-fill"></i></button>
        </div>

      </div>

      <div class="modal-footer">
        <button class="btn btn-primary" id="guardarPreferencias">Guardar preferencias</button>
      </div>

    </div>
  </div>
</div>

<script src="/js/accesibilidad.js"></script>