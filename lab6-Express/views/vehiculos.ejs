<section id="vehiculos">
    <h2>Vehículos</h2>

    <div id="contenedor-progreso">
        <label for="progreso">Progreso</label>
        <progress id="progreso" max="100" min="0" value=""></progress>
    </div>

    <form aria-label="Formulario de vehiculos" id="formulario-vehiculos" 
      data-modo = "<%= vehiculo ? 'editar' : 'crear' %>"
      data-id = "<%= vehiculo ? vehiculo.matricula : '' %>"
      action="<%= vehiculo && vehiculo.matricula ? '/vehiculos/' + vehiculo.matricula + '/editar' : '/vehiculos/nuevo' %>" 
      method="POST" enctype="multipart/form-data">
            
        <fieldset> 
          <legend>Información del vehiculo</legend>

          <% if(error){ %>
            <div class = "alert alert-danger" role = "alert">
              <% error.forEach(e => { %>
                <p><%=  e.msg %></p>
                <% }) %>
            </div>
          <% } %>

          <div class="container text-left">
            <div>
              <label for="matricula">Matricula:</label>
              <input type="text" id="matricula" name="matricula" value="<%= vehiculo && vehiculo.matricula ? vehiculo.matricula : '' %>" required>
            </div>

            <div>
              <label for="marca">Marca:</label>
              <input type="text" id="marca" name="marca" value="<%= vehiculo && vehiculo.marca ? vehiculo.marca : '' %>" required>
            </div>
  
            <div>
              <label for="modelo">Modelo:</label>
              <input type="text" id="modelo" name="modelo" value="<%= vehiculo && vehiculo.modelo ? vehiculo.modelo : '' %>" required>
            </div>

            <div>
              <label for="anyoMatriculacion">Año de matriculación:</label>
              <input type="text" id="anyoMatriculacion" name="anyoMatriculacion" value="<%= vehiculo && vehiculo.año_matriculacion ? vehiculo.año_matriculacion : '' %>" required>
            </div>

            <div>
              <label for="numeroPlazas">Número de plazas:</label>
              <input type="text" id="numeroPlazas" name="numeroPlazas" value="<%= vehiculo && vehiculo.numero_plazas ? vehiculo.numero_plazas : '' %>" required>
            </div>

            <div>
              <label for="autonomia">Autonomía (km):</label>
              <input type="text" id="autonomia" name="autonomia" value="<%= vehiculo && vehiculo.autonomia_km ? vehiculo.autonomia_km : '' %>" required>
            </div>

            <div>
              <label for="color">Color:</label>
              <input type="text" id="color" name="color" value="<%= vehiculo && vehiculo.color ? vehiculo.color : '' %>" required>
            </div>
  
            <div>
              <label for="tipo">Seleciona el tipo: </label>
              <select id="tipo" name="tipo" required>
                <option value="" disabled selected>Seleccione un tipo</option>
                <option value="coche" <%= vehiculo.tipo === 'coche' ? 'selected' : '' %>>Coche</option>
                <option value="moto" <%= vehiculo.tipo === 'moto' ? 'selected' : '' %>>Moto</option>
                <option value="patinete electrico" <%= vehiculo.tipo === 'patinete electrico' ? 'selected' : '' %>>Patinete Electrico</option>
              </select>
            </div>

            <div>
              <label for="estado">Seleciona el estado: </label>
              <select id="estado" name="estado" required>
                <option value="" disabled selected>Seleccione un estado</option>
                <option value="disponible" <%= vehiculo.estado === 'disponible' ? 'selected' : '' %>>Disponible</option>
                <option value="reservado" <%= vehiculo.estado === 'reservado' ? 'selected' : '' %>>Reservado</option>
                <option value="mantenimiento" <%= vehiculo.estado === 'mantenimiento' ? 'selected' : '' %>>Mantenimiento</option>
              </select>
            </div>
  
            <div>
              <label for="precioHora">Precio/Hora:</label>
              <input type="text" id="precioHora" name="precioHora" value = "<%= vehiculo && vehiculo.precio_hora ? vehiculo.precio_hora : '' %>" required>
            </div>

            <div>
              <label for="concesionario">Concesionario:</label>
              <input type="text" id="concesionario" name="concesionario" value="<%= vehiculo && vehiculo.id_concesionario ? vehiculo.id_concesionario : '' %>" required>
            </div>
                
            <div class="file-wrapper">
              <label for="imagen">Imagen del vehiculo</label>
              <input class="input-file" type="file" name="imagen" required>
            </div>
          </div>
        </fieldset>

        <div class="form-acciones">
            <button type="submit" class="btn btn-dark">Enviar</button>
            <button type="reset" class="btn btn-light">Borrar</button>
        </div>
    </form>

    <div class="modal fade" id="confirmacionModal" tabindex="-1" aria-labelledby="confirmacionLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h3 class="modal-title" id="confirmacionLabel">Confirmar vehículo</h3>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
          </div>
          <div class="modal-body">
            <p>¿Desea confirmar el vehiculo?</p>
            <!-- Aquí inyectar dinámicamente los datos del formulario -->
            <div id="resumen-vehiculo"></div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="button" class="btn btn-primary" id="confirmarVehiculo">Confirmar</button>
          </div>
        </div>
      </div>
    </div>
</section>
