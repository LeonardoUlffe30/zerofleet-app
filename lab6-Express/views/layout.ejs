<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width = device-width, initial-scale=1.0" />
  <title><%= titulo || "ZeroFleet" %>Gestión de Flota de Vehículos Eléctricos</title>
  
  <!-- Bootstrap CSS y Bootstrap Date & Time Picker (Tempus Dominus) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@eonasdan/tempus-dominus@6.9.4/dist/css/tempus-dominus.min.css" crossorigin="anonymous">

  <!-- css global -->
  <link id="estiloGeneral" rel="stylesheet" href="/css/general.css">
  <link id="estiloHeader" rel="stylesheet" href="/css/header.css">
  
  <!-- CSS específico -->
  <% if (estilo) { %>
    <link rel="stylesheet" href="/css/<%= estilo %>">
  <% } %>
</head>

<body>
  <!-- Header -->
  <%- include('partials/header') %>
  
  <main>
    <%- body %>
  </main>
  
  <!-- Footer -->
  <%- include('partials/footer') %>

  <!-- Modales globales -->
  <%- include('partials/iniciarSesion', {error: typeof error !== 'undefined' ? error: null}) %>
  <%- include('partials/registrar', {
    error: typeof error !== 'undefined' ? error : null,
    concesionarios: typeof concesionarios !== 'undefined' ? concesionarios : []}) %>
  <%- include('partials/accesibilidad') %>

  <!-- Popper, Bootstrap y Tempus Dominus JS -->
  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/@eonasdan/tempus-dominus@6.9.4/dist/js/tempus-dominus.min.js" crossorigin="anonymous"></script>


  <!-- Script global -->
  <script>
    window.abrirModalIniciarSesion = <%= typeof abrirModalIniciarSesion !== 'undefined' && abrirModalIniciarSesion ? 'true' : 'false' %>;
    window.abrirModalRegistrar = <%= typeof abrirModalRegistrar !== 'undefined' && abrirModalRegistrar ? 'true' : 'false' %>;
  </script>

  <script src="/js/index.js"></script>

  <!-- Script específico -->
  <% if (script) { %>
    <script src="/js/<%= script %>"></script>
  <% } %>

</body>

</html>