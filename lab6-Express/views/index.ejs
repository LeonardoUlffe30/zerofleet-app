
<% if (error) { %>
  <div class = "alert alert-danger text-center mt-3" role = "alert">
    <p> <%= error %> </p>
  </div>
<% } %>

<div class="fondoInicial">
  <div class="fondoInicial-texto">
    <h1>Plataforma de movilidad sostenible</h1>
    <p>Rápido, fácil y ecológico</p>
  </div>
</div>

<div class="contenido">
  <video controls class="video-responsive">
    <source src="videos/videoAutoElectrico.mp4" type="video/mp4">
    <source src="videos/videoAutoElectrico.webm" type="video/webm">
    Tu navegador no soporta la etiqueta de video.
  </video>

  <div class = "container text-center contenedorInfo">
    <h2>¿Qué es ZeroFleet?</h2>
    <p><strong>ZeroFleet</strong> es tu <em>solución innovadora</em> 
    para la gestión de flotas de vehículos eléctricos. Permite a los empleados 
    <strong>reservar y devolver vehículos</strong> de manera rápida y sencilla, siempre controlando 
    la <em>autonomía y disponibilidad</em> de cada unidad.</p>

    <p>Los beneficios de los coches eléctricos son:</p>
    <ol class="mx-auto">
      <li>Sostenibilidad ambiental</li>
      <li>Ahorro económico</li>
      <li>Innovación y eficiencia</li>
    </ol>
  </div>

  <div class="container text-center contenedorInfo">
    <h2> Tareas que podemos realizar</h2>
    <div class="row align-items-center justify-content-center">
      <div class="col-12 col-md-6 contenedorImagen">
        <img src="/img/tareasImagen.png" alt="tareas" title="tareas" id="tareasImagen">
      </div>

      <div class="col-12 col-md-6 d-flex justify-content-center">
        <ul>
          <li>Gestión de reservas y devoluciones</li>
          <li>Administración de flotas y concesionarios</li>
          <li>Generación de estadísticas y reportes</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Definiciones de tecnologías web -->
  <div class = "container text-center contenedorInfo">
    <h2> Tecnologías web utilizadas</h2>
    <div class = "row align-items-center">
      <dl class="col-12 col-md-6">
        <dt>HTML</dt>
        <dd>Lenguaje de marcado para estructurar páginas web &reg;.</dd>

        <dt>CSS</dt>
        <dd>Lenguaje de estilos para dar formato al contenido.</dd>

        <dt>JavaScript</dt>
        <dd>Lenguaje de programación para añadir interactividad.</dd>
      </dl>

      <div class="col-12 col-md-6 contenedorImagen">
        <img src="/img/tecnologiasImagen.png" alt="tecno" title="tecno" id="tecnologiaImagen">
      </div>
    </div>
  </div>

</div>