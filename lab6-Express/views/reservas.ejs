<section id="reserva">
    <h2>Reserva</h2>
    <div id="contenedor-progreso">
        <label for="progreso">Progreso</label>
        <progress id="progreso" max="100" min="0" value=""></progress>
    </div>

    <form aria-label="Formulario de reserva de vehiculos" id="formulario-reserva" novalidate>
        <div id="mensajes"></div>
        <fieldset> 
            <legend>Información personal</legend>

            <div class="container text-left">
                <div>
                    <label for="nombre">Nombre: </label>
                    <input type="text" id="nombre" name="nombre" required>
                </div>
                <div>
                    <label for="apellido">Apellido: </label>
                    <input type="text" id="apellido" name="apellido" required>
                </div>
                
                <div>
                    <label for="correoReserva">Email: </label>
                    <input type="email" id="correoReserva" name="correoReserva" required>
                </div>
                <div>
                    <label for="telefono">Teléfono: </label>
                    <input type="tel" id="telefono" name="telefono" pattern="[0-9]{9}">
                </div>
                
            </div>
        </fieldset>

        <fieldset>
            <legend>Vehículo</legend>

            <div class="container text-left">
                <div>
                    <label for="tipo">Vehículo: </label>
                    <select id="tipo" name="tipo" required>
                        <option value="" disabled selected>Seleccione un vehículo</option>
                        <option value="1234ABC">1234ABC</option>
                        <option value="1234BBC">1234BBC</option>
                        <option value="1234AAC">1234AAC</option>
                    </select>
                </div>
            </div>
        </fieldset>


        <fieldset>
            <legend>Fecha de Inicio</legend>

            <div class="container">
                <div>
                    <label for="fechaIni">Fecha: </label>
                    <input type="date" id="fechaIni" name="fechaIni" required>
                </div>

                <div>
                    <label for="horaIni">Hora: </label>
                    <input type="time" id="horaIni" name="horaIni" required>
                </div>
            </div>
        </fieldset>

        <fieldset>
            <legend>Fecha de Fin</legend>

            <div class="container">
                <div>
                    <label for="fechaFin">Fecha: </label>
                    <input type="date" id="fechaFin" name="fechaFin" required>
                </div>

                <div>
                    <label for="horaFin">Hora: </label>
                    <input type="time" id="horaFin" name="horaFin" required>
                </div>
            </div>
        </fieldset>

        <fieldset>
            <legend>Duración</legend>

            <div class="container">
                <div>
                    <label for="duracion">Horas de reserva: </label>
                    <input type="number" id="duracion" name="duracion" min="1">
                </div>
            </div>

        </fieldset>

        <div class="contenedor-condiciones">
            <div>
                <label for="condiciones">Condiciones</label>
                <input type="checkbox" id="condiciones" name="condiciones" required>
            </div>
        </div>

        <div class="form-acciones">
            <button type="submit" class="btn btn-dark">Enviar</button>
            <button type="reset" class="btn btn-light">Borrar</button>
        </div>
    </form>
        <div class="modal fade" id="confirmacionModal" tabindex="-1" aria-labelledby="confirmacionLabel" aria-hidden="true">
        <div class="modal-dialog">
        <div class="modal-content">
        <div class="modal-header">
            <h3 class="modal-title" id="confirmacionLabel">Confirmar reserva</h3>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body">
            <p>¿Desea confirmar la reserva?</p>
            <div id="resumen-reserva"></div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="button" class="btn btn-primary" id="confirmarReserva">Confirmar</button>
        </div>
        </div>
        </div>
        </div>
</section>
