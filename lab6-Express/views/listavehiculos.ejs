<div class="container" id="alertContainer"></div>
<div class="container-fluid">
  <div class="row text-left align-items-start">
    <div class="col-2 col-xl-2">
      <form class = "buscador" action = "/vehiculos" method = "GET" >

        <label for="campo">Filtrar: </label>
          <select id="filtroCampo" name="filtroCampo">
              <option value="" disabled selected>Seleccione el filtro</option>
              <option value="marca" <%= filtro === "marca" ? "selected" : "" %> >Marca</option>
              <option value="modelo" <%= filtro === "modelo" ? "selected" : "" %> >Modelo</option>
          </select>
          
          <label for="buscar"> </label>
          <input type="text" id="buscar" name="buscar" value="<%= buscar %>" placeholder="Introduce aqui la marca/modelo que quieras buscar">

          <label for="tipo"> Tipo vehiculo: </label>
          <select id="filtroTipo" name="filtroTipo">
              <option value="">Todos</option>
              <option value="coche">Coche</option>
              <option value="moto">Moto</option>
              <option value="patinete electrico">Patinete eléctrico</option>
          </select>
      </form>
    </div>

    <div class="col-12 col-xl-10">
      <section id="listaVehiculos">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h2 id="tituloTabla" class="m-0">Vehículos disponibles</h2>

          <% if(usuario && usuario.tipo === "admin") { %>
          <a href="/vehiculos/nuevo" class="btn btn-dark">+ Añadir</a>
          <% } %>
        </div>
        <div class="table-responsive text-center">
          <table aria-labelledby="tituloTabla" class="table table-sm table-hover align-middle" id="tablavehiculos">
            <thead class="table-dark text-center">
              <tr>
                <th scope="col">Imagen</th>
                <th scope="col">Matricula</th>
                <th scope="col">Marca</th>
                <th scope="col">Modelo</th>
                <th scope="col">Año</th>
                <th scope="col">Nº de Plazas</th>
                <th scope="col">Autonomía (km)</th>
                <th scope="col">Color</th>
                <th scope="col">Concesionario</th>
                <th scope="col">Estado</th>
                <th scope="col">Tipo</th>
                <th scope="col">Precio/Hora</th>
                <% if(usuario && usuario.tipo === "admin") {%>
                    <th scope="col">Acciones</th>
                  <% } %>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
           <script>const usuario = <%- JSON.stringify(usuario || null) %>;</script>
          <script src = "/js/listavehiculos.js"></script>
        </div>
      </section>
    </div>
  </div>
</div>


