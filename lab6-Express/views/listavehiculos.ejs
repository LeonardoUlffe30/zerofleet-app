<section id="listaVehiculos">
  <table>
    <form class = "buscador" action = "/vehiculos" method = "GET" >
      <label for="tipo">Seleciona el vehiculo: </label>
        <select id="filtro" name="filtro">
            <option value="" disabled selected>Seleccione el filtro</option>
            <option value="marca" <%= filtro === "marca" ? "selected" : "" %> >Marca</option>
            <option value="modelo" <%= filtro === "modelo" ? "selected" : "" %> >Modelo</option>
        </select>
      <label for="buscar"> </label>
      <input type="text" id="buscar" name="buscar" value="<%= buscar %>" placeholder="Introduce aqui la marca/modelo que quieras buscar">
    </form>
    <% if(error){ %>
          <div class = "alert alert-danger" role = "alert">
            <%= error %>
          </div>
          <% } %>
    <% if(mensaje){ %>
          <div class = "alert alert-success" role = "alert">
            <%= mensaje %>
          </div>
          <% } %>
    <% if(usuario && usuario.tipo === "admin") {%>
      <a href ="/vehiculos/nuevo" class="btnAniadir">Añadir vehiculo</a>
    <% } %>
    <caption><h2>Vehiculos disponibles</h2></caption>
    <thead>
      <tr>
        <th scope="col"></th>
        <th scope="col">Matricula</th>
        <th scope="col">Marca</th>
        <th scope="col">Autonomía (km)</th>
        <th scope="col">Tipo</th>
        <th scope="col">Modelo</th>
      </tr>
    </thead>
    <tbody>
      <% vehiculos.forEach(function(v) { %>
        <tr>
          <td><img src="/img/imgVehiculos/<%= v.imagen %>" alt="Imagen del vehiculo" width="100"></td>
          <td><%= v.id %></td>
          <td><%= v.marca %></td>
          <td><%= v.autonomia %></td>
          <td><%= v.tipo %></td>
          <td><%= v.modelo %></td>
          <% if(usuario && usuario.tipo === "admin") {%>
            <td>
               <a href ="/vehiculos/<%= v.id %>/editar" class="btnEditar"> Editar</a>
                <a href ="/vehiculos/<%= v.id %>/eliminar" class="btnEliminar"> Eliminar</a>
            </td>
          <% } %>
        </tr>
      <% }); %>
    </tbody>
  </table>
</section>